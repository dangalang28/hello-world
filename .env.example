# Shared password gating the operator UI. If unset, the gate is disabled (local dev).
OPERATOR_PASSWORD=

# Google Cloud API key with Places API + PageSpeed Insights API enabled.
# Without it: GBP check degrades to a manual checklist; PageSpeed runs keyless at low quota.
GOOGLE_API_KEY=

# Optional. Enables the AI-visibility check, generated copy (GBP description,
# meta rewrites) and report narrative. Everything else works without it.
ANTHROPIC_API_KEY=

# SERP data provider. Leave unset in V1 (branded-SERP section renders a manual
# checklist). Future values: serpapi | dataforseo
SERP_PROVIDER=
